<?xml version="1.0"?>
<VisualGDBUserPreferences xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <UserDefinedVariableValues />
  <DebugPreferences xsi:type="com.visualgdb.debug.embedded.preferences">
    <CatchpointConfiguration>
      <Exec>false</Exec>
      <Fork>false</Fork>
      <Vfork>false</Vfork>
      <Syscalls />
      <CXXCatchpoints />
    </CatchpointConfiguration>
    <VisualWatchPreferences />
    <MaskInterruptsWhileStepping>false</MaskInterruptsWhileStepping>
    <MemoryWindowPreferences>
      <MemoryWindowPreferences>
        <ExpressionHistory />
        <SymbolicMode>true</SymbolicMode>
        <TakeAddressMode>false</TakeAddressMode>
        <Format>
          <DataWidth>OneByte</DataWidth>
          <DataFormat>Hexadecimal</DataFormat>
          <TextFormat>ANSI</TextFormat>
        </Format>
        <LiveMemorySettings>
          <Enabled>true</Enabled>
          <BreakOnChanges>false</BreakOnChanges>
          <AutoRefresh>false</AutoRefresh>
          <RefreshTimeout>0</RefreshTimeout>
        </LiveMemorySettings>
        <ShowStatusBar>true</ShowStatusBar>
        <DisplaySymbols>false</DisplaySymbols>
      </MemoryWindowPreferences>
    </MemoryWindowPreferences>
    <LiveVariables>
      <LiveVariable>
        <Expression>g_tof26_diag</Expression>
        <Enabled>true</Enabled>
        <Breakpoint>
          <ComparisonMode>Equals</ComparisonMode>
          <Enabled>false</Enabled>
        </Breakpoint>
        <Plot>false</Plot>
        <IsCollapsed>true</IsCollapsed>
        <IsFavorite>false</IsFavorite>
      </LiveVariable>
      <LiveVariable>
        <Expression>g_pick_diag</Expression>
        <Enabled>true</Enabled>
        <Breakpoint>
          <ComparisonMode>Equals</ComparisonMode>
          <Enabled>false</Enabled>
        </Breakpoint>
        <Plot>false</Plot>
        <IsCollapsed>false</IsCollapsed>
        <IsFavorite>false</IsFavorite>
      </LiveVariable>
      <LiveVariable>
        <Expression>g_wait_diag</Expression>
        <Enabled>true</Enabled>
        <Breakpoint>
          <ComparisonMode>Equals</ComparisonMode>
          <Enabled>false</Enabled>
        </Breakpoint>
        <Plot>false</Plot>
        <IsCollapsed>true</IsCollapsed>
        <IsFavorite>false</IsFavorite>
      </LiveVariable>
      <LiveVariable>
        <Expression>g_torque_calib.limitPeak</Expression>
        <Enabled>true</Enabled>
        <Breakpoint>
          <ComparisonMode>Equals</ComparisonMode>
          <Enabled>false</Enabled>
        </Breakpoint>
        <Plot>false</Plot>
        <IsCollapsed>false</IsCollapsed>
        <IsFavorite>false</IsFavorite>
      </LiveVariable>
      <LiveVariable>
        <Expression>g_torque_calib.baseline</Expression>
        <Enabled>true</Enabled>
        <Breakpoint>
          <ComparisonMode>Equals</ComparisonMode>
          <Enabled>false</Enabled>
        </Breakpoint>
        <Plot>false</Plot>
        <IsCollapsed>false</IsCollapsed>
        <IsFavorite>false</IsFavorite>
      </LiveVariable>
      <LiveVariable>
        <Expression>g_motor_status</Expression>
        <Enabled>true</Enabled>
        <Breakpoint>
          <ComparisonMode>Equals</ComparisonMode>
          <Enabled>false</Enabled>
        </Breakpoint>
        <Plot>false</Plot>
        <IsCollapsed>true</IsCollapsed>
        <IsFavorite>false</IsFavorite>
      </LiveVariable>
      <LiveVariable>
        <Expression>g_home_diag_parallel</Expression>
        <Enabled>true</Enabled>
        <Breakpoint>
          <ComparisonMode>Equals</ComparisonMode>
          <Enabled>false</Enabled>
        </Breakpoint>
        <Plot>false</Plot>
        <IsCollapsed>false</IsCollapsed>
        <IsFavorite>false</IsFavorite>
      </LiveVariable>
    </LiveVariables>
    <LoadGlobalsWithoutConfirmation>false</LoadGlobalsWithoutConfirmation>
    <NestedLiveVariables>
      <NestedVariableSettingsCollection>
        <ID>com.sysprogs.AllGlobals</ID>
        <Variables />
      </NestedVariableSettingsCollection>
      <NestedVariableSettingsCollection>
        <ID>com.sysprogs.SpecificVariables</ID>
        <Variables>
          <LiveVariable>
            <Expression>g_home_diag_parallel[0]</Expression>
            <Enabled>true</Enabled>
            <Breakpoint>
              <ComparisonMode>Equals</ComparisonMode>
              <Enabled>false</Enabled>
            </Breakpoint>
            <Plot>false</Plot>
            <IsCollapsed>false</IsCollapsed>
            <IsFavorite>false</IsFavorite>
          </LiveVariable>
          <LiveVariable>
            <Expression>g_home_diag_parallel[0].deviceId</Expression>
            <Type>com.sysprogs.types.builtin.UInt8</Type>
            <Enabled>true</Enabled>
            <Breakpoint>
              <ComparisonMode>Equals</ComparisonMode>
              <Enabled>false</Enabled>
            </Breakpoint>
            <Plot>true</Plot>
            <IsCollapsed>false</IsCollapsed>
            <IsFavorite>false</IsFavorite>
          </LiveVariable>
          <LiveVariable>
            <Expression>g_home_diag_parallel[0].phase</Expression>
            <Type>com.sysprogs.types.builtin.UInt8</Type>
            <Enabled>true</Enabled>
            <Breakpoint>
              <ComparisonMode>Equals</ComparisonMode>
              <Enabled>false</Enabled>
            </Breakpoint>
            <Plot>true</Plot>
            <IsCollapsed>false</IsCollapsed>
            <IsFavorite>false</IsFavorite>
          </LiveVariable>
          <LiveVariable>
            <Expression>g_home_diag_parallel[1]</Expression>
            <Enabled>true</Enabled>
            <Breakpoint>
              <ComparisonMode>Equals</ComparisonMode>
              <Enabled>false</Enabled>
            </Breakpoint>
            <Plot>false</Plot>
            <IsCollapsed>false</IsCollapsed>
            <IsFavorite>false</IsFavorite>
          </LiveVariable>
          <LiveVariable>
            <Expression>g_home_diag_parallel[1].deviceId</Expression>
            <Type>com.sysprogs.types.builtin.UInt8</Type>
            <Enabled>true</Enabled>
            <Breakpoint>
              <ComparisonMode>Equals</ComparisonMode>
              <Enabled>false</Enabled>
            </Breakpoint>
            <Plot>true</Plot>
            <IsCollapsed>false</IsCollapsed>
            <IsFavorite>false</IsFavorite>
          </LiveVariable>
          <LiveVariable>
            <Expression>g_home_diag_parallel[1].phase</Expression>
            <Type>com.sysprogs.types.builtin.UInt8</Type>
            <Enabled>true</Enabled>
            <Breakpoint>
              <ComparisonMode>Equals</ComparisonMode>
              <Enabled>false</Enabled>
            </Breakpoint>
            <Plot>true</Plot>
            <IsCollapsed>false</IsCollapsed>
            <IsFavorite>false</IsFavorite>
          </LiveVariable>
          <LiveVariable>
            <Expression>g_home_diag_parallel[2]</Expression>
            <Enabled>true</Enabled>
            <Breakpoint>
              <ComparisonMode>Equals</ComparisonMode>
              <Enabled>false</Enabled>
            </Breakpoint>
            <Plot>false</Plot>
            <IsCollapsed>false</IsCollapsed>
            <IsFavorite>false</IsFavorite>
          </LiveVariable>
          <LiveVariable>
            <Expression>g_home_diag_parallel[2].deviceId</Expression>
            <Type>com.sysprogs.types.builtin.UInt8</Type>
            <Enabled>true</Enabled>
            <Breakpoint>
              <ComparisonMode>Equals</ComparisonMode>
              <Enabled>false</Enabled>
            </Breakpoint>
            <Plot>true</Plot>
            <IsCollapsed>false</IsCollapsed>
            <IsFavorite>false</IsFavorite>
          </LiveVariable>
          <LiveVariable>
            <Expression>g_home_diag_parallel[2].phase</Expression>
            <Type>com.sysprogs.types.builtin.UInt8</Type>
            <Enabled>true</Enabled>
            <Breakpoint>
              <ComparisonMode>Equals</ComparisonMode>
              <Enabled>false</Enabled>
            </Breakpoint>
            <Plot>true</Plot>
            <IsCollapsed>false</IsCollapsed>
            <IsFavorite>false</IsFavorite>
          </LiveVariable>
        </Variables>
      </NestedVariableSettingsCollection>
      <NestedVariableSettingsCollection>
        <ID>com.sysprogs.Custom</ID>
        <Variables />
      </NestedVariableSettingsCollection>
    </NestedLiveVariables>
    <LiveVariablePreferences>
      <ViewMode>SpecificVariables</ViewMode>
      <FavoritesOnly>false</FavoritesOnly>
    </LiveVariablePreferences>
    <Suggestions />
    <HardwareRegisters />
  </DebugPreferences>
</VisualGDBUserPreferences>